---
import Layout from './Layout.astro';

interface Props {
	title: string;
	description: string;
	date: Date;
	tags?: string[];
	readingMinutes: number;
}

const { title, description, date, tags, readingMinutes } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<Layout title={`${title} — Dušan Osmokrović`} description={description}>
	<article class="py-16 sm:py-24 px-6">
		<div class="max-w-3xl mx-auto">
			<a
				href="/#writings"
				class="inline-flex items-center gap-2 font-heading text-sm font-bold uppercase tracking-wider text-muted-foreground hover:text-foreground transition-colors mb-12"
			>
				<span>&larr;</span> Back to writings
			</a>

			<header class="mb-12 border-b-4 border-black dark:border-white pb-8">
				<div class="flex items-center gap-3 mb-4">
					<time class="font-mono text-sm text-muted-foreground" datetime={date.toISOString()}>
						{formattedDate}
					</time>
					<span class="text-muted-foreground">·</span>
					<span class="font-mono text-sm text-muted-foreground">{readingMinutes} min read</span>
					{tags && tags.length > 0 && (
						<span class="text-muted-foreground">·</span>
						<div class="flex gap-2">
							{tags.map(tag => (
								<span class="text-xs font-bold uppercase tracking-wider bg-lime text-black px-2 py-0.5 border border-black">
									{tag}
								</span>
							))}
						</div>
					)}
				</div>
				<h1 class="font-heading text-3xl sm:text-5xl font-black uppercase leading-tight tracking-tight">
					{title}
				</h1>
				<p class="text-lg text-muted-foreground mt-4">{description}</p>
			</header>

			<div class="prose">
				<slot />
			</div>
		</div>
	</article>
</Layout>

<style>
	@reference "../styles/global.css";
	.prose {
		@apply text-base sm:text-lg leading-relaxed;
	}
	.prose :global(h2) {
		@apply font-heading text-2xl sm:text-3xl font-black uppercase tracking-tight mt-12 mb-4;
	}
	.prose :global(h3) {
		@apply font-heading text-xl sm:text-2xl font-bold uppercase tracking-tight mt-8 mb-3;
	}
	.prose :global(p) {
		@apply mb-6 text-foreground/85;
	}
	.prose :global(a) {
		@apply border-b-2 border-coral hover:text-coral transition-colors;
	}
	.prose :global(strong) {
		@apply font-bold text-foreground;
	}
	.prose :global(code) {
		@apply font-mono text-sm bg-muted px-1.5 py-0.5 border border-border;
	}
	.prose :global(pre) {
		@apply bg-muted border-3 border-black dark:border-white p-6 overflow-x-auto mb-6 mt-4;
	}
	.prose :global(pre code) {
		@apply bg-transparent border-0 p-0;
	}
	.prose :global(ul) {
		@apply mb-6 pl-6 list-disc space-y-2;
	}
	.prose :global(ol) {
		@apply mb-6 pl-6 list-decimal space-y-2;
	}
	.prose :global(li) {
		@apply text-foreground/85;
	}
	.prose :global(blockquote) {
		@apply border-l-4 border-coral pl-6 italic text-muted-foreground my-6;
	}
	.prose :global(hr) {
		@apply border-t-2 border-border my-12;
	}
</style>
