---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { label: 'Writing', href: '/#writing' },
  { label: 'Contact', href: '/#contact' },
];
---
<header class="sticky top-0 z-50 backdrop-blur-md bg-background/70 border-b border-border">
  <div class="max-w-6xl mx-auto px-6 sm:px-10 h-16 flex items-center justify-between gap-4">
    <a href="/" class="group flex items-baseline gap-3 min-w-0">
      <span class="font-display text-xl tracking-tight">Dušan Osmokrović</span>
      <span class="hidden sm:inline eyebrow">// SE</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2 shrink-0">
      <nav class="hidden sm:flex items-center">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-sm text-foreground/70 hover:text-foreground px-3 py-2 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden md:flex items-center gap-2 px-3 mx-1 border-l border-border h-6" id="now-playing-header">
        <span id="now-playing-icon" class="hidden items-end gap-[2px] shrink-0 h-3">
          <span class="w-[2px] h-3 bg-clay animate-equalizer-1"></span>
          <span class="w-[2px] h-3 bg-clay animate-equalizer-2"></span>
          <span class="w-[2px] h-3 bg-clay animate-equalizer-3"></span>
        </span>
        <span id="now-playing-text" class="eyebrow truncate max-w-[180px] normal-case tracking-wider" style="text-transform: none;">
          —
        </span>
      </div>

      <ThemeToggle />

      <button
        id="mobile-menu-btn"
        class="sm:hidden flex flex-col justify-center items-center w-10 h-10 gap-[5px]"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="w-5 h-px bg-foreground transition-all duration-300 origin-center" id="burger-top"></span>
        <span class="w-5 h-px bg-foreground transition-all duration-300" id="burger-mid"></span>
        <span class="w-5 h-px bg-foreground transition-all duration-300 origin-center" id="burger-bot"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="sm:hidden hidden border-t border-border bg-background">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="block font-display text-2xl px-6 py-4 border-b border-border hover:text-clay transition-colors mobile-nav-link"
      >
        {link.label}
      </a>
    ))}
  </div>
</header>


<script is:inline>
  (function() {
    var textEl = document.getElementById('now-playing-text');
    var iconEl = document.getElementById('now-playing-icon');

    async function fetchNowPlaying() {
      if (!textEl) return;
      try {
        var res = await fetch('/api/now-playing');
        var data = await res.json();
        if (data.isPlaying) {
          textEl.textContent = data.title + ' — ' + data.artist;
          iconEl?.classList.remove('hidden');
          iconEl?.classList.add('flex');
        } else {
          textEl.textContent = '—';
          iconEl?.classList.add('hidden');
          iconEl?.classList.remove('flex');
        }
      } catch {}
    }

    fetchNowPlaying();
    setInterval(function() {
      if (!document.hidden) fetchNowPlaying();
    }, 30000);
  })();

  (function() {
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    var top = document.getElementById('burger-top');
    var mid = document.getElementById('burger-mid');
    var bot = document.getElementById('burger-bot');
    if (!btn || !menu) return;

    var open = false;
    btn.addEventListener('click', function() {
      open = !open;
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      top.style.transform = open ? 'translateY(6px) rotate(45deg)' : '';
      mid.style.opacity = open ? '0' : '1';
      bot.style.transform = open ? 'translateY(-6px) rotate(-45deg)' : '';
    });

    menu.querySelectorAll('.mobile-nav-link').forEach(function(link) {
      link.addEventListener('click', function() {
        open = false;
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        top.style.transform = '';
        mid.style.opacity = '1';
        bot.style.transform = '';
      });
    });
  })();
</script>
