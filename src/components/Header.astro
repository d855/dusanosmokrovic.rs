---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { label: 'Work', href: '#work' },
  { label: 'Writings', href: '#writings' },
  { label: 'Contact', href: '#contact' },
];
---
<header class="border-b-4 border-black dark:border-white bg-background sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-2">
    <div class="flex flex-col -ml-2 min-w-0 flex-1">
      <a href="/" class="font-heading text-base sm:text-xl font-black tracking-tight uppercase hover:bg-lime hover:text-black px-2 py-0.5 transition-colors block whitespace-nowrap overflow-hidden text-ellipsis">
        Dušan Osmokrović
      </a>
      <div class="px-2 flex items-center gap-1.5 min-w-0" id="now-playing-header">
        <span id="now-playing-icon" class="flex items-end gap-[2px] shrink-0 h-3 hidden">
          <span class="w-[3px] h-3 bg-coral origin-bottom animate-equalizer-1"></span>
          <span class="w-[3px] h-3 bg-coral origin-bottom animate-equalizer-2"></span>
          <span class="w-[3px] h-3 bg-coral origin-bottom animate-equalizer-3"></span>
        </span>
        <span id="now-playing-text" class="text-[10px] text-muted-foreground whitespace-nowrap font-mono truncate min-w-0">
          Not playing
        </span>
      </div>
    </div>

    <nav class="flex items-center gap-1 sm:gap-2 shrink-0">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="font-heading text-xs sm:text-sm font-bold uppercase tracking-wider hover:bg-foreground hover:text-background px-3 py-2 transition-colors hidden sm:block"
        >
          {link.label}
        </a>
      ))}
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        class="sm:hidden flex flex-col justify-center items-center w-10 h-10 gap-[5px]"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="w-5 h-[3px] bg-foreground transition-all duration-200 origin-center" id="burger-top"></span>
        <span class="w-5 h-[3px] bg-foreground transition-all duration-200" id="burger-mid"></span>
        <span class="w-5 h-[3px] bg-foreground transition-all duration-200 origin-center" id="burger-bot"></span>
      </button>
    </nav>
  </div>

  <div id="mobile-menu" class="sm:hidden hidden border-t-2 border-black dark:border-white bg-background">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="block font-heading text-sm font-bold uppercase tracking-wider px-6 py-4 border-b border-border hover:bg-foreground hover:text-background transition-colors mobile-nav-link"
      >
        {link.label}
      </a>
    ))}
  </div>
</header>


<script is:inline>
  (function() {
    var textEl = document.getElementById('now-playing-text');
    var iconEl = document.getElementById('now-playing-icon');

    async function fetchNowPlaying() {
      if (!textEl) return;
      try {
        var res = await fetch('/api/now-playing');
        var data = await res.json();
        if (data.isPlaying) {
          textEl.textContent = data.title + ' — ' + data.artist;
          iconEl?.classList.remove('hidden');
        } else {
          textEl.textContent = 'Not playing';
          iconEl?.classList.add('hidden');
        }
      } catch {}
    }

    fetchNowPlaying();
    setInterval(function() {
      if (!document.hidden) fetchNowPlaying();
    }, 30000);
  })();

  (function() {
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    var top = document.getElementById('burger-top');
    var mid = document.getElementById('burger-mid');
    var bot = document.getElementById('burger-bot');
    if (!btn || !menu) return;

    var open = false;
    btn.addEventListener('click', function() {
      open = !open;
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      top.style.transform = open ? 'translateY(8px) rotate(45deg)' : '';
      mid.style.opacity = open ? '0' : '1';
      bot.style.transform = open ? 'translateY(-8px) rotate(-45deg)' : '';
    });

    menu.querySelectorAll('.mobile-nav-link').forEach(function(link) {
      link.addEventListener('click', function() {
        open = false;
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        top.style.transform = '';
        mid.style.opacity = '1';
        bot.style.transform = '';
      });
    });
  })();
</script>
