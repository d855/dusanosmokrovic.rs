---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../lib/utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 4)
	.map(post => ({ ...post, readingMinutes: readingTime(post.body ?? '') }));

---

<Layout>
	<!-- ─────────────── HERO ─────────────── -->
	<section class="relative overflow-hidden">
		<!-- Decorative shapes -->
		<div class="pointer-events-none absolute inset-0 z-0" id="shapes-container" aria-hidden="true">
			<!-- thin outlined circle, top right -->
			<div data-shape data-speed="0.7" class="absolute top-[8%] right-[6%] w-32 h-32 sm:w-44 sm:h-44 rounded-full border border-foreground/15 animate-drift transition-transform duration-700 ease-out"></div>
			<!-- small clay filled dot -->
			<div data-shape data-speed="1.4" class="absolute top-[26%] right-[14%] w-2.5 h-2.5 rounded-full bg-clay transition-transform duration-700 ease-out"></div>
			<!-- triangle outline, mid-left -->
			<svg data-shape data-speed="0.9" class="absolute top-[42%] left-[3%] sm:left-[6%] w-14 h-14 sm:w-20 sm:h-20 text-clay/70 animate-spin-slow transition-transform duration-700 ease-out" viewBox="0 0 100 100" fill="none">
				<polygon points="50,8 92,88 8,88" stroke="currentColor" stroke-width="1.25" />
			</svg>
			<!-- square outline, lower right -->
			<div data-shape data-speed="1.1" class="absolute bottom-[18%] right-[20%] w-16 h-16 sm:w-24 sm:h-24 border border-foreground/20 rotate-12 animate-drift transition-transform duration-700 ease-out" style="animation-delay: 1.2s"></div>
			<!-- plus mark, top-left -->
			<svg data-shape data-speed="1.3" class="absolute top-[16%] left-[22%] w-7 h-7 text-clay transition-transform duration-700 ease-out" viewBox="0 0 24 24" fill="none">
				<line x1="12" y1="2" x2="12" y2="22" stroke="currentColor" stroke-width="1.25" />
				<line x1="2" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="1.25" />
			</svg>
			<!-- zigzag, lower left -->
			<svg data-shape data-speed="0.5" class="absolute bottom-[10%] left-[8%] w-28 h-6 text-foreground/25 animate-drift transition-transform duration-700 ease-out" style="animation-delay: 1.8s" viewBox="0 0 96 24" fill="none">
				<path d="M0 18 L12 6 L24 18 L36 6 L48 18 L60 6 L72 18 L84 6 L96 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
			</svg>
			<!-- donut, right mid -->
			<div data-shape data-speed="0.8" class="absolute top-[60%] right-[5%] sm:right-[8%] w-12 h-12 rounded-full border-2 border-clay/40 animate-spin-slow transition-transform duration-700 ease-out"></div>
			<!-- tiny dots scatter -->
			<div data-shape data-speed="1.8" class="absolute top-[34%] right-[42%] w-1.5 h-1.5 rounded-full bg-foreground/30 transition-transform duration-700 ease-out"></div>
			<div data-shape data-speed="1.6" class="absolute top-[72%] left-[34%] w-1.5 h-1.5 rounded-full bg-clay/70 transition-transform duration-700 ease-out"></div>
			<div data-shape data-speed="2.0" class="absolute top-[80%] right-[36%] w-1 h-1 rounded-full bg-foreground/25 transition-transform duration-700 ease-out"></div>
			<!-- arc / quarter circle -->
			<svg data-shape data-speed="0.6" class="absolute top-[6%] left-[8%] w-20 h-20 text-foreground/20 transition-transform duration-700 ease-out" viewBox="0 0 100 100" fill="none">
				<path d="M 6 94 A 88 88 0 0 1 94 6" stroke="currentColor" stroke-width="1.25" />
			</svg>
		</div>

		<div class="relative z-10 max-w-6xl mx-auto px-6 sm:px-10 pt-16 sm:pt-28 pb-24 sm:pb-40">
			<div class="grid grid-cols-12 gap-6 sm:gap-10">
				<div class="col-span-12 lg:col-span-9">
					<h1 class="font-display text-[44px] sm:text-7xl lg:text-[104px] leading-[1.02] tracking-[-0.025em]">
						<span class="block animate-fade-up" style="animation-delay: 0.15s"><em class="font-display-italic text-clay">AI-powered</em> software</span>
						<span class="block animate-fade-up" style="animation-delay: 0.25s">that solves</span>
						<span class="block animate-fade-up" style="animation-delay: 0.35s">
							real problems<span class="text-clay">.</span>
						</span>
					</h1>

					<div class="grid grid-cols-12 gap-6 sm:gap-10 mt-14 sm:mt-20">
						<div class="col-span-12 sm:col-span-7 lg:col-span-6 animate-fade-up" style="animation-delay: 0.5s">
							<p class="text-lg sm:text-xl leading-relaxed text-foreground/75 max-w-xl">
								Hi, I'm <span class="text-foreground">Dušan</span> — a software engineer who turns
								ideas into products people actually use. I care about good UX, clean architecture,
								and shipping work that holds up.
							</p>
						</div>

						<div class="col-span-12 sm:col-span-5 lg:col-span-4 lg:col-start-9 animate-fade-up flex sm:justify-end" style="animation-delay: 0.6s">
							<div class="flex flex-col gap-3 text-sm">
								<a href="#writing" class="group inline-flex items-center gap-3 self-start">
									<span class="link-underline">Read recent notes</span>
									<span class="text-clay transition-transform group-hover:translate-x-1">→</span>
								</a>
								<a href="#contact" class="group inline-flex items-center gap-3 self-start text-foreground/70 hover:text-foreground transition-colors">
									<span class="link-grow">Get in touch</span>
									<span class="text-clay transition-transform group-hover:translate-x-1">→</span>
								</a>
							</div>
						</div>
					</div>
				</div>

			</div>

		</div>
	</section>


	<!-- ─────────────── WRITING ─────────────── -->
	<section id="writing" class="relative px-6 sm:px-10 py-24 sm:py-36 border-t border-border">
		<div class="max-w-6xl mx-auto">
			<div class="flex items-end justify-between gap-4 flex-wrap mb-16 sm:mb-20" data-animate>
				<h2 class="font-display text-4xl sm:text-6xl leading-[1.05] tracking-tight">
					Writing & <em class="font-display-italic text-clay">field notes</em>.
				</h2>
				<a href="/blog" class="group inline-flex items-center gap-2 text-sm">
					<span class="link-underline">All writing</span>
					<span class="text-clay transition-transform group-hover:translate-x-1">→</span>
				</a>
			</div>

			<div class="border-t border-border">
				{posts.map((post, i) => (
					<a href={`/blog/${post.id}`} data-animate data-animate-delay={String(i + 1)} class="group block border-b border-border py-8 transition-colors hover:bg-foreground/[0.015]">
						<div class="grid grid-cols-12 gap-4 items-baseline">
							<div class="col-span-2 sm:col-span-2 font-mono text-xs text-muted-foreground">
								{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
							</div>
							<div class="col-span-10 sm:col-span-7">
								<h3 class="font-display text-2xl sm:text-3xl leading-tight tracking-tight">
									<span class="link-grow">{post.data.title}</span>
								</h3>
								{post.data.description && (
									<p class="text-foreground/65 text-sm leading-relaxed mt-2 max-w-2xl">{post.data.description}</p>
								)}
							</div>
							<div class="col-span-12 sm:col-span-3 sm:text-right font-mono text-xs text-muted-foreground">
								{post.readingMinutes} min read
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ─────────────── CONTACT ─────────────── -->
	<section id="contact" class="relative px-6 sm:px-10 py-24 sm:py-40 border-t border-border overflow-hidden">
		<div class="pointer-events-none absolute inset-0">
			<div class="absolute -bottom-40 -right-32 w-[640px] h-[640px] rounded-full bg-clay/10 blur-3xl animate-drift"></div>
		</div>

		<div class="relative max-w-6xl mx-auto">
			<div class="grid grid-cols-12 gap-6 sm:gap-10">
				<div class="col-span-12 lg:col-span-8" data-animate>
					<h2 class="font-display text-5xl sm:text-7xl lg:text-8xl leading-[1.0] tracking-tight">
						Have something <em class="font-display-italic text-clay">good</em><br />
						to build? Let's talk.
					</h2>
					<a href="mailto:dosmokrovic@yahoo.com" class="inline-flex items-baseline gap-3 mt-12 group">
						<span class="font-display text-2xl sm:text-3xl link-underline">dosmokrovic@yahoo.com</span>
						<span class="text-clay text-2xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
					</a>
				</div>

				<div class="col-span-12 lg:col-span-4 flex flex-col gap-6 lg:items-end" data-animate data-animate-delay="2">
					<div>
						<div class="eyebrow mb-3 lg:text-right">Elsewhere</div>
						<ul class="flex flex-col gap-2 lg:items-end">
							<li><a href="https://github.com/d855" target="_blank" rel="noopener" class="link-underline">GitHub</a></li>
							<li><a href="https://linkedin.com/in/dusanosmokrovic" target="_blank" rel="noopener" class="link-underline">LinkedIn</a></li>
							<li><a href="/rss.xml" class="link-underline">RSS feed</a></li>
						</ul>
					</div>
					<div class="lg:text-right">
						<div class="eyebrow mb-3">Local time</div>
						<div class="font-display text-2xl" id="local-time">—</div>
					</div>
				</div>
			</div>

			<div class="hairline mt-24 sm:mt-32"></div>

			<div class="flex justify-between items-center pt-8 text-xs text-muted-foreground font-mono">
				<span>© 2026 — Dušan Osmokrović</span>
				<span>Designed & built in Belgrade</span>
			</div>
		</div>
	</section>
</Layout>

<script is:inline>
	(function shapesParallax() {
		var container = document.getElementById('shapes-container');
		if (!container || window.matchMedia('(pointer: coarse)').matches) return;
		var shapes = container.querySelectorAll('[data-shape]');
		var mx = -1000, my = -1000, raf = null;

		document.addEventListener('mousemove', function(e) {
			mx = e.clientX; my = e.clientY;
			if (!raf) raf = requestAnimationFrame(update);
		});

		function update() {
			raf = null;
			shapes.forEach(function(shape) {
				var rect = shape.getBoundingClientRect();
				var cx = rect.left + rect.width / 2;
				var cy = rect.top + rect.height / 2;
				var dx = cx - mx, dy = cy - my;
				var dist = Math.sqrt(dx * dx + dy * dy);
				var radius = 320;
				if (dist < radius) {
					var speed = parseFloat(shape.dataset.speed) || 1;
					var force = (1 - dist / radius) * 32 * speed;
					var ang = Math.atan2(dy, dx);
					shape.style.translate = (Math.cos(ang) * force) + 'px ' + (Math.sin(ang) * force) + 'px';
				} else {
					shape.style.translate = '0 0';
				}
			});
		}
		document.addEventListener('mouseleave', function() {
			shapes.forEach(function(s) { s.style.translate = '0 0'; });
		});
	})();

	(function scrollAnimate() {
		var els = document.querySelectorAll('[data-animate]');
		if (!els.length) return;
		var observer = new IntersectionObserver(function(entries) {
			entries.forEach(function(entry) {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			});
		}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
		els.forEach(function(el) { observer.observe(el); });
	})();

	(function localTime() {
		var el = document.getElementById('local-time');
		if (!el) return;
		function tick() {
			var t = new Date().toLocaleTimeString('en-GB', { timeZone: 'Europe/Belgrade', hour: '2-digit', minute: '2-digit' });
			el.textContent = t + ' CET';
		}
		tick();
		setInterval(tick, 30000);
	})();
</script>
